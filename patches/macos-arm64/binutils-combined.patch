+fragment <<EOF
+/* C-SKY archive references can be introduced by libraries appearing later
+   on the command line.  Finish their fixed-point search before the normal
+   ELF after-open processing.  */
+static void
+csky_elf_after_open (void)
+{
+  /* Archive cycles can introduce new requirements.  Resolve them before
+     choosing the printf implementation.  */
+  lang_rescan_archives ();
+  bfd_csky_defer_printf_selection (FALSE);
+  /* Pull the selected printf member and its dependencies.  */
+  lang_rescan_archives ();
+  gld${EMULATION_NAME}_after_open ();
+}
