+/* The C-SKY vendor linker revisits archives after later libraries introduce
+   new undefined references.  Use the same archive reload path as an explicit
+   group, but leave objects and --as-needed shared libraries alone.  */
+void
+lang_rescan_archives (void)
+{
+  struct bfd_link_hash_entry *undefs;
+
+  do
+    {
+      undefs = link_info.hash->undefs_tail;
+      current_target = default_target;
+      open_input_bfds (statement_list.head,
+                       OPEN_BFD_RESCAN | OPEN_BFD_ARCHIVES_ONLY);
+    }
+  while (undefs != link_info.hash->undefs_tail);
+}
