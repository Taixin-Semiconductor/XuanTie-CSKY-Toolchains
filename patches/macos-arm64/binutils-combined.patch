diff --git a/ld/testsuite/ld-csky/printf-archive.exp b/ld/testsuite/ld-csky/printf-archive.exp
new file mode 100644
index 00000000..3a307491
--- /dev/null
+++ b/ld/testsuite/ld-csky/printf-archive.exp
@@ -0,0 +1,106 @@
+# C-SKY printf selector and archive rescan regression tests.
+
+if ![istarget csky-*-*] {
+    return
+}
+
+global ar
+global as
+global ld
+global nm
+
+set sources {
+    printf-base printf-f printf-m printf-late-m printf-call printf-wrapper printf-small
+    printf-f-variant printf-m-variant archive-first archive-later archive-main
+    archive-trigger
+}
+foreach source $sources {
+    if ![ld_assemble $as $srcdir/$subdir/$source.s tmpdir/$source.o] {
+        unresolved "csky printf archive fixtures"
+        return
+    }
+}
+
+remote_file host delete "tmpdir/libprintf-variants.a"
+set output [run_host_cmd "$ar" "rcs tmpdir/libprintf-variants.a tmpdir/printf-wrapper.o tmpdir/printf-small.o tmpdir/printf-f-variant.o tmpdir/printf-m-variant.o"]
+if {![string match "" $output]} {
+    unresolved "csky printf archive fixtures"
+    return
+}
+
+foreach {input expected forbidden} {
+    printf-base __v2_printf$S __v2_printf$DFHLlOPpSSsWp
+    printf-f __v2_printf$DFHLlOPpSSsWp __v2_printf$S
+    printf-m __v2_printf$DFHLlMOPpSSsWp __v2_printf$S
+    printf-call __v2_printf$DFHLlMOPpSSsWp __v2_printf$S
+} {
+    set testname "csky printf archive selector $input"
+    if ![ld_simple_link $ld tmpdir/$input-result.o "-r tmpdir/$input.o tmpdir/libprintf-variants.a"] {
+        fail $testname
+        continue
+    }
+    set symbols [run_host_cmd "$nm" "tmpdir/$input-result.o"]
+    if {[string match "* T $expected*" $symbols]
+        && ![string match "* T $forbidden*" $symbols]} {
+        pass $testname
+    } else {
+        fail $testname
+    }
+}
+
+set testname "csky printf late requirement"
+if ![ld_simple_link $ld tmpdir/printf-late-result.o "-r tmpdir/printf-base.o tmpdir/libprintf-variants.a tmpdir/printf-late-m.o"] {
+    fail $testname
+} else {
+    set symbols [run_host_cmd "$nm" "tmpdir/printf-late-result.o"]
+    if {[string match "* T __v2_printf\$DFHLlMOPpSSsWp*" $symbols]
+        && ![string match "* T __v2_printf\$S*" $symbols]} {
+        pass $testname
+    } else {
+        fail $testname
+    }
+}
+
+remote_file host delete "tmpdir/libarchive-first.a"
+remote_file host delete "tmpdir/libarchive-later.a"
+set first [run_host_cmd "$ar" "rcs tmpdir/libarchive-first.a tmpdir/archive-first.o"]
+set later [run_host_cmd "$ar" "rcs tmpdir/libarchive-later.a tmpdir/archive-later.o"]
+if {![string match "" $first] || ![string match "" $later]} {
+    unresolved "csky archive order fixtures"
+    return
+}
+
+set testname "csky archive order rescan"
+if ![ld_simple_link $ld tmpdir/archive-order-result.o "-r tmpdir/archive-main.o tmpdir/libarchive-first.a tmpdir/libarchive-later.a"] {
+    fail $testname
+} else {
+    set symbols [run_host_cmd "$nm" "tmpdir/archive-order-result.o"]
+    if {[string match "* T early_symbol*" $symbols]
+        && [string match "* T later_symbol*" $symbols]} {
+        pass $testname
+    } else {
+        fail $testname
+    }
+}
+
+# The first archive is reached only during rescan.  Its marker must still
+# influence the printf member chosen from the archive in the middle.
+remote_file host delete "tmpdir/libarchive-marker.a"
+set marker [run_host_cmd "$ar" "rcs tmpdir/libarchive-marker.a tmpdir/archive-first.o"]
+if {![string match "" $marker]} {
+    unresolved "csky late archive marker fixture"
+    return
+}
+set testname "csky marker from rescanned archive"
+if ![ld_simple_link $ld tmpdir/archive-marker-result.o "-r tmpdir/printf-base.o tmpdir/archive-trigger.o tmpdir/libprintf-variants.a tmpdir/libarchive-marker.a tmpdir/libarchive-later.a"] {
+    fail $testname
+} else {
+    set symbols [run_host_cmd "$nm" "tmpdir/archive-marker-result.o"]
+    if {[string match "* T early_symbol*" $symbols]
+        && [string match "* T __v2_printf\$DFHLlMOPpSSsWp*" $symbols]
+        && ![string match "* T __v2_printf\$S*" $symbols]} {
+        pass $testname
+    } else {
+        fail $testname
+    }
+}
