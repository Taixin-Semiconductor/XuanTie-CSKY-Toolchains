+/* The minilibc printf archive contains several definitions of __v2_printf.
+   A plain archive search takes the first one, which need not implement the
+   formats requested by .required references.  The names below are the
+   selector symbols exported by that archive.  */
+static const struct
+{
+  const char *name;
+  unsigned int bit;
+  const char *suffix;
+} csky_printf_features[] =
+{
+  { "_printf_d",           0x002, "D" },
+  { "_printf_f",           0x100, "F" },
+  { "_printf_p",           0x008, "H" },
+  { "_printf_lld",         0x080, "Ll" },
+  { "_printf_m",           0x200, "M" },
+  { "_printf_o",           0x004, "O" },
+  { "_printf_pre_padding", 0x040, "Pp" },
+  { "_printf_s",           0x001, "S" },
+  { "_printf_sizespec",    0x020, "Ss" },
+  { "_printf_widthprec",   0x010, "Wp" }
+};
+
+/* The order is significant: choose the first available implementation that
+   contains every requested feature.  It is the order used by the V3.10.33
+   linker with the bundled minilibc archive.  */
+static const unsigned short csky_printf_variants[] =
+{
+  0x001, 0x011, 0x002, 0x003, 0x013, 0x023, 0x033, 0x063,
+  0x073, 0x0e3, 0x0f3, 0x00b, 0x01b, 0x02b, 0x03b, 0x06b,
+  0x07b, 0x0eb, 0x0fb, 0x00f, 0x01f, 0x02f, 0x03f, 0x06f,
+  0x07f, 0x0ef, 0x0ff, 0x1ff, 0x3ff
+};
+
+/* ld delays selecting a variant until every input has contributed its
+   .required references.  Other BFD users retain immediate selection.  */
+static bfd_boolean csky_printf_selection_deferred;
+
+void
+bfd_csky_defer_printf_selection (bfd_boolean defer)
+{
+  csky_printf_selection_deferred = defer;
+}
+
+static bfd_boolean
+csky_printf_variant_archive_p (bfd *abfd)
+{
+  symindex i;
+  carsym *symbols = bfd_ardata (abfd)->symdefs;
+
+  for (i = 0; i < bfd_ardata (abfd)->symdef_count; ++i)
+    if (strcmp (symbols[i].name, "__v2_printf$DFHLlMOPpSSsWp") == 0)
+      return TRUE;
+  return FALSE;
+}
+
+static bfd_boolean
+csky_printf_undefined_p (struct bfd_link_info *info, const char *name)
+{
+  struct elf_link_hash_entry *h;
+
+  h = elf_link_hash_lookup (elf_hash_table (info), name, FALSE, FALSE, TRUE);
+  return h != NULL && (h->root.type == bfd_link_hash_undefined
+                       || h->root.type == bfd_link_hash_undefweak);
+}
+
+static unsigned int
+csky_printf_required_mask (struct bfd_link_info *info)
+{
+  unsigned int mask = 0;
+  unsigned int i;
+
+  for (i = 0; i < sizeof (csky_printf_features)
+                 / sizeof (csky_printf_features[0]); ++i)
+    if (csky_printf_undefined_p (info, csky_printf_features[i].name))
+      mask |= csky_printf_features[i].bit;
+  return mask;
+}
+
+static bfd_boolean
+csky_printf_explicit_variant_p (bfd *abfd, struct bfd_link_info *info)
+{
+  symindex i;
+  carsym *symbols = bfd_ardata (abfd)->symdefs;
+
+  for (i = 0; i < bfd_ardata (abfd)->symdef_count; ++i)
+    if (strncmp (symbols[i].name, "__v2_printf$", 12) == 0
+        && csky_printf_undefined_p (info, symbols[i].name))
+      return TRUE;
+  return FALSE;
+}
+
+static void
+csky_printf_variant_name (unsigned int required, char name[32])
+{
+  unsigned int chosen = 0x3ff;
+  unsigned int i;
+  char *out = name;
+
+  for (i = 0; i < sizeof (csky_printf_variants)
+                 / sizeof (csky_printf_variants[0]); ++i)
+    if ((csky_printf_variants[i] & required) == required)
+      {
+        chosen = csky_printf_variants[i];
+        break;
+      }
+
+  memcpy (out, "__v2_printf$", 12);
+  out += 12;
+  for (i = 0; i < sizeof (csky_printf_features)
+                 / sizeof (csky_printf_features[0]); ++i)
+    if (chosen & csky_printf_features[i].bit)
+      {
+        size_t length = strlen (csky_printf_features[i].suffix);
+        memcpy (out, csky_printf_features[i].suffix, length);
+        out += length;
+      }
+  *out = '\0';
+}
+
+/* Resolve the suffixed selector before the unsuffixed __v2_printf entry can
+   extract the small S member.  Leave ordinary archives and explicit -u
+   selector requests under the generic ELF archive rules.  */
+static struct elf_link_hash_entry *
+csky_elf_archive_symbol_lookup (bfd *abfd, struct bfd_link_info *info,
+                                const char *name)
+{
+  struct elf_link_hash_entry *base;
+  unsigned int required;
+  bfd_boolean explicit_variant;
+  char selected[32];
+
+  if (strcmp (name, "__v2_printf") != 0
+      && strncmp (name, "__v2_printf$", 12) != 0)
+    return _bfd_elf_archive_symbol_lookup (abfd, info, name);
+
+  if (!csky_printf_variant_archive_p (abfd))
+    return _bfd_elf_archive_symbol_lookup (abfd, info, name);
+
+  base = _bfd_elf_archive_symbol_lookup (abfd, info, "__v2_printf");
+  if (base == NULL || base == (struct elf_link_hash_entry *) 0 - 1
+      || (base->root.type != bfd_link_hash_undefined
+          && base->root.type != bfd_link_hash_undefweak))
+    return _bfd_elf_archive_symbol_lookup (abfd, info, name);
+
+  required = csky_printf_required_mask (info);
+  explicit_variant = csky_printf_explicit_variant_p (abfd, info);
+  if (strcmp (name, "__v2_printf") == 0)
+    return csky_printf_selection_deferred || required != 0 || explicit_variant
+      ? NULL : base;
+
+  if (explicit_variant || required == 0)
+    return _bfd_elf_archive_symbol_lookup (abfd, info, name);
+
+  if (csky_printf_selection_deferred)
+    return NULL;
+
+  csky_printf_variant_name (required, selected);
+  return strcmp (name, selected) == 0 ? base
+    : _bfd_elf_archive_symbol_lookup (abfd, info, name);
+}
+
 /* End of external entry points for sizing and building linker stubs.  */
 
 /* CPU related basical API. */
