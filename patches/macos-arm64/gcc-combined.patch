+++ b/gcc/testsuite/gcc.target/csky/required-printf-disabled.c
@@ -0,0 +1,18 @@
+/* { dg-do compile { target csky*-*-*abiv2* } } */
+/* { dg-options "-mcpu=ck803 -mfloat-abi=soft -Os -mno-required-printf" } */
+
+extern int printf (const char *, ...);
+extern int snprintf (char *, __SIZE_TYPE__, const char *, ...);
+
+int
+csky_required_printf_disabled (char *buffer, __SIZE_TYPE__ size, int value)
+{
+  return snprintf (buffer, size, "value=%d", value)
+         + printf ("value=%d\n", value);
+}
+
+/* -mno-required-printf disables both markers and helper calls.  */
+/* { dg-final { scan-assembler-not "\\.required _printf_" } } */
+/* { dg-final { scan-assembler-not "__cskyvprintf" } } */
+/* { dg-final { scan-assembler-times "jbsr[ \t]+snprintf" 1 } } */
+/* { dg-final { scan-assembler-times "jbsr[ \t]+printf" 1 } } */
diff --git a/gcc/testsuite/gcc.target/csky/required-printf-fallback.c b/gcc/testsuite/gcc.target/csky/required-printf-fallback.c
new file mode 100644
index 000000000..f12fa4019
--- /dev/null
+++ b/gcc/testsuite/gcc.target/csky/required-printf-fallback.c
@@ -0,0 +1,16 @@
+/* { dg-do compile { target csky*-*-*abiv2* } } */
+/* { dg-options "-mcpu=ck803 -mfloat-abi=soft -Os" } */
+
+extern int printf (const char *, ...);
+
+int
+csky_required_printf_fallback (const char *format, int value)
+{
+  return (printf (format, value) + printf ("%c", value)
+          + printf ("%s %u", "value", (unsigned int) value)
+          + printf ("%08.3x", (unsigned int) value));
+}
+
+/* Dynamic, unsupported, and incompletely marked formats keep libc calls.  */
+/* { dg-final { scan-assembler-not "\\.required _printf_" } } */
+/* { dg-final { scan-assembler-times "jbsr[ \t]+printf" 4 } } */
diff --git a/gcc/testsuite/gcc.target/csky/required-printf.c b/gcc/testsuite/gcc.target/csky/required-printf.c
new file mode 100644
index 000000000..0940971bf
--- /dev/null
+++ b/gcc/testsuite/gcc.target/csky/required-printf.c
@@ -0,0 +1,27 @@
+/* { dg-do compile { target csky*-*-*abiv2* } } */
+/* { dg-options "-mcpu=ck803 -mfloat-abi=soft -Os" } */
+
+extern int printf (const char *, ...);
+extern int snprintf (char *, __SIZE_TYPE__, const char *, ...);
+
+int
+csky_required_printf_probe (char *buffer, __SIZE_TYPE__ size, int d,
+                            unsigned int u, unsigned int x, void *p,
+                            double f, const char *s, long l, long long ll)
+{
+  int n = snprintf (buffer, size,
+                    "d=%d u=%u x=%08x p=%p f=%.3f s=%s", d, u, x, p, f, s);
+  return n + printf ("count=%d text=%s long=%ld wide=%lld\n", d, s, l, ll);
+}
+
