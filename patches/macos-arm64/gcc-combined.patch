+/* { dg-final { scan-assembler-times "\\.required _printf_s" 2 } } */
+/* { dg-final { scan-assembler-times "\\.required _printf_p" 2 } } */
+/* { dg-final { scan-assembler-times "\\.required _printf_pre_padding" 1 } } */
+/* { dg-final { scan-assembler-times "\\.required _printf_f" 1 } } */
+/* { dg-final { scan-assembler-times "\\.required _printf_sizespec" 1 } } */
+/* { dg-final { scan-assembler "__cskyvprintfsnprintf" } } */
+/* { dg-final { scan-assembler "__cskyvprintfprintf" } } */
+/* { dg-final { scan-assembler-not "jbsr[ \t]+snprintf" } } */
+/* { dg-final { scan-assembler-not "jbsr[ \t]+printf" } } */
