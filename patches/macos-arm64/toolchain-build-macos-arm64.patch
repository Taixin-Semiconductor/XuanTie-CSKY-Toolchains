@@ -5,7 +5,46 @@
 import logging
 import sys
 import os
+import platform
+import subprocess
 from CskyGCCToolchain import CskyGccToolchain
+
+
+def validate_native_host(host):
+    native_hosts = {
+        "linux-arm64": "Linux",
+        "macos-arm64": "Darwin",
+    }
+    expected_system = native_hosts.get(host)
+    if expected_system is None:
+        return
+    system = platform.system()
+    machine = platform.machine().lower()
+    if system != expected_system or machine not in ("arm64", "aarch64"):
+        raise ValueError("--host {} requires native {} arm64 (found {} {})".format(
+            host, expected_system, system, machine))
+
+
+def git_output(src, *args):
+    try:
+        return subprocess.check_output(["git", "-C", src] + list(args),
+                                       stderr=subprocess.PIPE,
+                                       universal_newlines=True).strip()
+    except (OSError, subprocess.CalledProcessError) as exc:
+        raise ValueError("cannot read Git source checkout at {}: {}".format(src, exc))
+
+
+def resolve_build_version(src, explicit_version):
+    if explicit_version is not None:
+        return explicit_version, None
+    root = git_output(src, "rev-parse", "--show-toplevel")
+    if os.path.realpath(root) != os.path.realpath(src):
+        raise ValueError("--src must be the root of the Git source checkout: {}".format(root))
+    commit = git_output(src, "rev-parse", "--verify", "HEAD")
+    if git_output(src, "status", "--porcelain", "--untracked-files=all",
+                  "--ignore-submodules=none"):
+        raise ValueError("automatic --version requires a clean Git source checkout")
+    return "V3.10-source-{}".format(commit[:12]), commit
 
 
